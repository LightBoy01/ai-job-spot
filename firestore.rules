rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the user is authenticated and has the 'admin' custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Jobs collection rules
    match /jobs/{jobId} {
      // Allow read access to anyone
      allow read: if true;

      // Allow create, update, delete only if the user is an admin
      allow create, update, delete: if isAdmin();
    }

    // Articles collection rules (assuming similar admin access)
    match /articles/{articleId} {
      // Allow read access to anyone
      allow read: if true;

      // Allow create, update, delete only if the user is an admin
      allow create, update, delete: if isAdmin();
    }

    // Other collections might have different rules
    // match /{document=**} {
    //   allow read, write: if false; // Default deny
    // }
  }
}