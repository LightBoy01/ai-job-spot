rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the user is authenticated and has the 'admin' custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Jobs collection rules
    match /jobs/{jobId} {
      // Public can only read published jobs. Admins can read all.
      allow read: if (resource.data.status == 'published') || isAdmin();

      // Allow create, update, delete only if the user is an admin
      allow create, update, delete: if isAdmin();
    }

    // Articles collection rules
    match /articles/{articleId} {
      // Public can only read published articles. Admins can read all.
      allow read: if (resource.data.status == 'published') || isAdmin();

      // Allow create, update, delete only if the user is an admin
      allow create, update, delete: if isAdmin();
    }

    // Aggregated articles collection rules
    match /aggregatedArticles/{articleId} {
      // Public can only read published aggregated articles. Admins can read all.
      allow read: if (resource.data.status == 'published') || isAdmin();

      // Disallow all writes
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      // Users can read and write their own profile. Admins can do everything.
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Sources collection (for internal config)
    match /sources/{sourceId} {
        allow read, write: if isAdmin();
    }

    // Metadata collection (for aggregated tags, etc.)
    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all reads and writes to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
