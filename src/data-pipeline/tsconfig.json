{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../../dist/data-pipeline",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../lib/**/*.ts"],
  "exclude": ["./**/*.test.ts", "../lib/__mocks__/**/*.ts"]
}