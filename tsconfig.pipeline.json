{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/data-pipeline/**/*.ts", "scripts/**/*.ts", "src/lib/**/*.js"],
  "exclude": ["node_modules", "scripts/debug/**/*.ts", "scripts/archive/**/*.ts", "scripts/migrations/**/*.ts"]
}
